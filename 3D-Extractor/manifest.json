{
  "manifest_version": 3,
  "name": "3D Extractor",
  "version": "1.0",
  "description": "WebGL 3D mesh and texture extractor",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "3D Extractor"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "webgl_hook.js",
        "libs/jszip.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
